# CrewOS runs fully without any keys: PayPal flows use a built-in simulator and
# the crew uses a rule-based "offline brain". Add keys to switch on the real thing.
# Copy this file to .env.local for local development.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding https://<your-host>/api/paypal/webhook to the app.
PAYPAL_WEBHOOK_ID=
# Sandbox personal account email that receives every supplier payout.
PAYPAL_PAYOUT_RECEIVER=

# --- Claude (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Optional ---
# Kai refunds instantly up to this amount (whole dollars, 0-500). Default 25.
AUTO_REFUND_LIMIT_USD=
# Where the JSON demo data lives. Default ./.data
DATA_DIR=
